config:aarch64::generic:darwin:Apple clang version 21.0.0 (clang-2100.1.1.101):--cc=clang --disable-autodetect --disable-doc --disable-debug --disable-network --disable-everything --disable-ffplay --enable-ffmpeg --enable-ffprobe --enable-protocol='file,pipe' --enable-demuxer='aac,aiff,flac,matroska,mov,mp3,ogg,wav,s16le,f32le' --enable-decoder='aac*,alac,flac,mp3*,opus,vorbis,pcm_*,adpcm_*' --enable-parser='aac,aac_latm,flac,mpegaudio,opus,vorbis' --enable-filter='aresample,aformat,anull,atrim,volume' --enable-muxer='ipod,wav,f32le,s16le' --enable-encoder='aac,pcm_s16le,pcm_f32le'
