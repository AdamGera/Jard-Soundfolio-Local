.{
    .id = "local.jardaudio.desktop",
    .name = "jard-soundfolio-local",
    .display_name = "Jard Soundfolio Local",
    .description = "Your recordings, transcripts, and notes stay on your Mac.",
    .version = "0.1.0",
    .platforms = .{"macos"},
    .icons = .{"assets/icon.png"},
    .web_engine = "system",
    .capabilities = .{"webview", "js_bridge", "menus"},
    .permissions = .{"view", "microphone", "system_audio"},
    .security = .{ .navigation = .{
        .allowed_origins = .{"zero://inline", "http://127.0.0.1:8765"},
        .external_links = .{ .action = "deny" },
    } },
    .windows = .{ .{ .label = "main", .title = "Jard Soundfolio Local", .width = 1050, .height = 760, .titlebar = "hidden_inset_tall", .restore_state = true } },
}
